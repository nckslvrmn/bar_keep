<%= form_with(model: item) do |form| %>
  <% if item.errors.any? %>
    <div class="alert alert-danger">
      <h6><%= pluralize(item.errors.count, "error") %> prohibited this item from being saved:</h6>
      <ul>
        <% item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="col-md-8">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">Basic Information</h5>

          <div class="mb-3">
            <%= form.label :name, class: "form-label" %>
            <%= form.text_field :name, class: "form-control", required: true %>
          </div>

          <div class="mb-3" data-controller="category-picker">
            <%= form.label :category_names, "Categories", class: "form-label" %>
            <%= form.text_field :category_names,
                class: "form-control",
                placeholder: "Enter categories separated by commas (e.g., Spirits, Whiskey, Premium)",
                data: {
                  category_picker_target: "field",
                  action: "input->category-picker#sync"
                } %>
            <div class="form-text">New categories are created automatically.</div>

            <% if categories.any? %>
              <div class="category-suggestions mt-2">
                <% categories.each do |category| %>
                  <button type="button"
                          class="btn btn-sm btn-outline-secondary"
                          data-category-picker-target="option"
                          data-category-picker-name-param="<%= category.name %>"
                          data-action="category-picker#toggle"><%= category.name %></button>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="mb-3">
            <%= form.label :item_type, "Type", class: "form-label" %>
            <%= form.select :item_type, options_for_select(Item::ITEM_TYPES, item.item_type || Item::ITEM_TYPES.first), {}, class: "form-select", required: true %>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <%= form.label :quantity, class: "form-label" %>
                <%= form.number_field :quantity, class: "form-control", min: 0, required: true, inputmode: "numeric" %>
              </div>
            </div>

            <div class="col-md-6">
              <div class="mb-3">
                <%= form.label :low_stock_threshold, class: "form-label" %>
                <%= form.number_field :low_stock_threshold, class: "form-control", min: 0, inputmode: "numeric" %>
                <div class="form-text">Alert when quantity drops to this level</div>
              </div>
            </div>
          </div>

          <% image_search = BraveImageSearch.enabled? %>
          <div class="mb-3" <%= tag.attributes(data: { controller: "image-search", image_search_url_value: image_search_items_path }) if image_search %>>
            <%= form.label :image, "Product Image", class: "form-label" %>
            <% if item.persisted? && item.image.attached? %>
              <div class="mb-2">
                <p>Current image:</p>
                <div class="rounded p-3 text-center">
                  <%= optimized_item_image(item, class: "item-image", style: "object-fit: contain;") %>
                </div>
                <div class="form-check">
                  <%= form.check_box :remove_image, class: "form-check-input" %>
                  <%= form.label :remove_image, "Remove image", class: "form-check-label" %>
                </div>
              </div>
            <% end %>
            <%= form.file_field :image, class: "form-control", accept: "image/*",
                data: (image_search ? { image_search_target: "file", action: "change->image-search#clearSelection" } : {}) %>

            <% if image_search %>
              <div class="input-group mt-2">
                <input type="search" class="form-control" placeholder="Or search the web for an image"
                       aria-label="Image search query"
                       data-image-search-target="query"
                       data-action="keydown.enter->image-search#search:prevent">
                <button type="button" class="btn btn-outline-secondary" data-action="image-search#search">Search</button>
              </div>
              <div class="form-text" data-image-search-target="status" aria-live="polite"></div>
              <div class="image-search-results mt-2" data-image-search-target="results"></div>
              <div data-image-search-target="selection"></div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">Additional Information</h5>
          <p class="text-muted">Add custom fields like purchase location, notes, etc.</p>

          <div data-controller="metadata-fields">
          <div id="metadata-fields" data-metadata-fields-target="fields">
            <% if metadata.any? %>
              <% metadata.each do |key, value| %>
                <div class="metadata-field mb-3">
                  <label class="form-label"><%= key.humanize %></label>
                  <% if key == 'notes' %>
                    <textarea name="metadata[<%= key %>]" class="form-control" rows="3"><%= value %></textarea>
                  <% else %>
                    <input type="text" name="metadata[<%= key %>]" class="form-control" value="<%= value %>">
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <div class="metadata-field mb-3">
                <input type="text" name="metadata[purchase_location]" class="form-control mb-2" placeholder="Purchase Location">
              </div>
              <div class="metadata-field mb-3">
                <input type="text" name="metadata[price]" class="form-control mb-2" placeholder="Price">
              </div>
              <div class="metadata-field mb-3">
                <textarea name="metadata[notes]" class="form-control" rows="3" placeholder="Notes"></textarea>
              </div>
            <% end %>
          </div>

          <button type="button" class="btn btn-sm btn-secondary" data-action="metadata-fields#open">+ Add Custom Field</button>

          <dialog class="metadata-dialog" closedby="any" aria-labelledby="add-field-title" data-metadata-fields-target="dialog">
            <div class="card">
              <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0" id="add-field-title">Add Custom Field</h5>
                <button type="button" class="btn-close" aria-label="Close" data-action="metadata-fields#close"></button>
              </div>
              <div class="card-body">
                <label for="metadata-field-name" class="form-label">Field Name</label>
                <input type="text" id="metadata-field-name" class="form-control" placeholder="e.g., Purchase Date, Brand, etc." autofocus
                       data-metadata-fields-target="name"
                       data-action="keydown.enter->metadata-fields#add:prevent">
                <div class="form-text">The field name will be used as the label for this custom field.</div>
              </div>
              <div class="card-footer d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" data-action="metadata-fields#close">Cancel</button>
                <button type="button" class="btn btn-primary" data-action="metadata-fields#add">Add Field</button>
              </div>
            </div>
          </dialog>

          <template data-metadata-fields-target="template">
            <div class="metadata-field mb-3">
              <label class="form-label"></label>
              <input type="text" class="form-control">
            </div>
          </template>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-3">
    <%= form.submit item.persisted? ? "Update Item" : "Create Item", class: "btn btn-primary" %>
    <%= link_to "Cancel", item.persisted? ? item : items_path, class: "btn btn-secondary" %>
  </div>
<% end %>
